FEATURE_FLAGS_JSON=
# Example:
# FEATURE_FLAGS_JSON={\"onboarding_flow_v1\":{\"enabled\":true,\"rolloutPercentage\":50}}
# FF_ONBOARDING_FLOW_V1_ENABLED=true
